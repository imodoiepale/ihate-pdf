{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ihate-pdf",
  "version": "1.1.0",
  "identifier": "com.ihatepdf.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:43127",
    "beforeBuildCommand": "npm run tauri:prepare",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "i hate pdf",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:43128 http://127.0.0.1:43127 https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first desktop PDF studio",
    "longDescription": "Merge, split, extract, and analyze PDFs on this computer. No upload, no accounts.",
    "publisher": "James Epale",
    "copyright": "Copyright © 2026 James Epale",
    "resources": {
      "resources/engine": "engine",
      "resources/pdf-tools": "pdf-tools",
      "resources/node": "node"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": ["qpdf", "poppler-utils", "python3"]
      },
      "rpm": {
        "depends": ["qpdf", "poppler-utils", "python3"]
      }
    }
  }
}
