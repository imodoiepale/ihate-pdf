{
  "name": "ihate-pdf",
  "version": "1.1.0",
  "description": "i hate pdf — local-first desktop PDF studio that drops iLovePDF-style upload caps, quotas, and accounts. Merge, split, compress, convert, and batch huge files on disk. Bring your own LLM keys.",
  "main": "./out/main/index.js",
  "author": "James Epale <ijepale@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/imodoiepale/ihate-pdf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imodoiepale/ihate-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/imodoiepale/ihate-pdf/issues"
  },
  "desktopName": "ihate-pdf.desktop",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox --disable-gpu",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev -- --no-sandbox --disable-gpu",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:engine": "vite build --config vite.engine.config.ts",
    "engine": "npm run build:engine && node out/engine/index.cjs",
    "tauri": "tauri",
    "tauri:prepare": "npm run build && npm run build:engine && node scripts/prepare-tauri.mjs",
    "tauri:dev": "npm run build:engine && tauri dev",
    "tauri:build": "tauri build",
    "icons": "python3 scripts/generate-icons.py",
    "smoke": "node scripts/smoke-pdf.mjs",
    "test:engine": "node scripts/smoke-pdf.mjs",
    "test:extract": "node scripts/test-extract.mjs",
    "mcp": "node mcp/ihate-pdf-mcp.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.3.5"
  }
}
