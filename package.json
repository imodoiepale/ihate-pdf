{
  "name": "ihate-pdf",
  "version": "1.0.0",
  "description": "IHATE PDF — local-first desktop PDF studio that drops iLovePDF-style upload caps, quotas, and accounts. Merge, split, compress, convert, and batch huge files on disk. Bring your own LLM keys.",
  "main": "./out/main/index.js",
  "author": "James Epale <ijepale@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox --disable-gpu",
    "dev:web": "electron-vite dev --rendererOnly",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev -- --no-sandbox --disable-gpu",
    "smoke": "node scripts/smoke-pdf.mjs",
    "test:engine": "node scripts/smoke-pdf.mjs",
    "test:extract": "node scripts/test-extract.mjs",
    "mcp": "node mcp/ihate-pdf-mcp.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.7.5",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.3.5"
  }
}
